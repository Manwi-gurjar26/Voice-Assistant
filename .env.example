# Copy this file to `.env` and fill in your own values.
# Never commit a file that contains real keys.

# ---------------------------------------------------------------------------
# LiveKit  (required) — https://cloud.livekit.io  ->  Settings -> Keys
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret

# ---------------------------------------------------------------------------
# Speech  (required) — https://console.deepgram.com
# Powers both speech-to-text (nova-3) and text-to-speech (aura-2).
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key

# ---------------------------------------------------------------------------
# Language model (required for real answers — set at least one).
# Without a working key here, Aura falls back to a small offline responder
# that can only greet you and echo what you said.
# ---------------------------------------------------------------------------
# https://platform.openai.com/api-keys   (needs billing credit)
OPENAI_API_KEY=sk-your_openai_api_key

# https://aistudio.google.com/apikey     (has a free tier)
# GEMINI_API_KEY=your_gemini_api_key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=8000
